    "validate:science": "node scripts/validate-science.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "6.4.4"
  }
}
